{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMS Desktop",
  "version": "1.0.0",
  "identifier": "io.github.rohing1.tms-desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "settings",
      "title": "TMS · 连接服务器",
      "width": 1000,
      "height": 700,
      "minWidth": 760,
      "minHeight": 600,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": [{ "identifier": "settings-only", "windows": ["settings"], "permissions": ["core:default"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "TMS 线路管理与用户自助中心桌面客户端",
    "longDescription": "Connect to your own TMS Service Center server. No local database or Java installation required.",
    "homepage": "https://github.com/Rohing1/tms-service-center",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    },
    "macOS": { "minimumSystemVersion": "12.0" },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }, "rpm": { "depends": ["webkit2gtk4.1", "gtk3"] } }
  }
}
